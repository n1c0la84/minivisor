# Bochs config for minivisor. Needs Bochs built with --enable-x86-64 --enable-vmx=2.
megs: 64
cpu: model=corei7_haswell_4770, count=1, reset_on_triple_fault=0
romimage: file=$BXSHARE/BIOS-bochs-latest
vgaromimage: file=$BXSHARE/VGABIOS-lgpl-latest.bin
ata0-master: type=disk, path=build/minivisor.img, mode=flat, cylinders=2, heads=16, spt=63
boot: disk
display_library: nogui
port_e9_hack: enabled=1
magic_break: enabled=1
log: build/bochs.log
panic: action=fatal
error: action=report
info: action=report
debug: action=ignore
